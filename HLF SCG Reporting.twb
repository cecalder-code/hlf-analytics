      <aliases enabled='yes' />
      <column datatype='integer' name='[# of Days between collections]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[__tableau_internal_object_id__].[cnt:Alteryx_72FFE32F9A614C07BD749BB651A75608:qk]&quot;' value='No. of Collections' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[avg:\# of Days between collections:qk]&quot;' value='Avg. Days between collections' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[avg:Calculation_412923817372864517:qk]&quot;' value='SCG per mile driven (lbs)' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[avg:Calculation_412923817374404614:qk]&quot;' value='CO₂e Avoided per Mile (lbs) ' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[avg:Net lbs:qk]&quot;' value='Avg. SCG mass per collection (lbs)' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[avg:Per Day (lbs):qk]&quot;' value='Avg. SCG generated per day (lbs)' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[sum:Calculation_412923817372172292:qk]&quot;' value='CO₂e Generated from Driving (lbs) ' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[sum:CO2e (lbs):qk]&quot;' value='CO2e (lbs) Diverted' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[sum:Master Gardener:qk]&quot;' value='SCG Donated to Pitt County Arboretum (lbs)' />
          <alias key='&quot;[federated.1u6c6ql1744kcf16d7wg31287u20].[usr:Calculation_412923817063219200:qk]&quot;' value='Pickup Interval Variance' />
        </aliases>
      </column>
      <column datatype='real' name='[CO2e (lbs)]' role='measure' type='quantitative' />
      <column caption='Avg Weekly SCG' datatype='real' name='[Calculation_1577948745585491968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net lbs])/COUNTD([Calculation_1577948745586528257])' />
      </column>
      <column caption='Year and Week #' datatype='string' name='[Calculation_1577948745586528257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Date]))+&quot; &quot;+STR([Week #])' />
      </column>
      <column caption='YTD Net Lbs' datatype='real' name='[Calculation_1577948745591062530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATEDIFF((&apos;year&apos;),[Date],TODAY()) = 0&#13;&#10;&#13;&#10;AND [Date] &lt;= TODAY()&#13;&#10;&#13;&#10;THEN [Net lbs]&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='Methane Avoided (lbs)' datatype='real' name='[Calculation_1577948745594322948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CO2e (lbs)]/28' />
      </column>
      <column caption='Store Shortened' datatype='string' name='[Calculation_2853030399312756738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([Store], &quot;Stanton&quot;) then &quot;Stanton&quot;&#13;&#10;elseif CONTAINS([Store], &quot;Red Banks&quot;) then &quot;Red Banks&quot;&#13;&#10;ELSEIF CONTAINS([Store], &quot;100 East 10th Street&quot;) then &quot;10th St&quot;&#13;&#10;else [Store]&#13;&#10;END' />
      </column>
      <column caption='Store Number and Name' datatype='string' name='[Calculation_3067232839104532480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3751217044297113600]+&quot; (&quot;+ ([Calculation_2853030399312756738])+&quot;)&quot;' />
      </column>
      <column aggregation='Avg' caption='Store Latitude' datatype='real' name='[Calculation_3067232839105822721]' role='dimension' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_3751217044297113600]=&quot;8582&quot; then 35.582703208531186&#13;&#10;elseif [Calculation_3751217044297113600]=&quot;8962&quot; then 35.60603330064299&#13;&#10;elseif [Calculation_3751217044297113600]= &quot;13481&quot; then 35.60565292725027&#13;&#10;elseif [Calculation_3751217044297113600]= &quot;27296&quot; then 35.55201327873732&#13;&#10;END' />
      </column>
      <column caption='Store Number' datatype='string' name='[Calculation_3751217044297113600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([Store], &quot;Stanton&quot;) then &quot;8962&quot;&#13;&#10;elseif CONTAINS([Store], &quot;Red Banks&quot;) then &quot;8582&quot;&#13;&#10;ELSEIF CONTAINS([Store], &quot;100 East 10th Street&quot;) then &quot;13481&quot;&#13;&#10;ELSEIF CONTAINS([Store], &quot;Winterville&quot;) then &quot;27296&quot;&#13;&#10;else [Store]&#13;&#10;END' />
      </column>
      <column caption='STDEV Days between collections' datatype='real' name='[Calculation_412923817063219200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([# of Days between collections])' />
      </column>
      <column caption='Window_Max' datatype='string' name='[Calculation_412923817070370817]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if SUM([Net lbs])=WINDOW_MAX(SUM([Net lbs])) then &quot;Max&quot;&#13;&#10;else &quot;Other&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Transportation CO2e' datatype='real' name='[Calculation_412923817372172292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Miles Driven]*.89' />
      </column>
      <column caption='SCG lbs per mile driven' datatype='real' name='[Calculation_412923817372864517]' role='measure' type='quantitative'>
