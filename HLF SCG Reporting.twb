    <worksheet name='Avg Weekly SCG'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='10'>AVG Weekly SCG  (lbs)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Alteryx (Coffee Grounds Data - Alteryx Output)' name='federated.1u6c6ql1744kcf16d7wg31287u20' />
          </datasources>
          <datasource-dependencies datasource='federated.1u6c6ql1744kcf16d7wg31287u20'>
            <column caption='Avg Weekly SCG' datatype='real' name='[Calculation_1577948745585491968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Net lbs])/COUNTD([Calculation_1577948745586528257])' />
            </column>
            <column caption='Year and Week #' datatype='string' name='[Calculation_1577948745586528257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([Date]))+&quot; &quot;+STR([Week #])' />
            </column>
            <column caption='Store Number' datatype='string' name='[Calculation_3751217044297113600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([Store], &quot;Stanton&quot;) then &quot;8962&quot;&#13;&#10;elseif CONTAINS([Store], &quot;Red Banks&quot;) then &quot;8582&quot;&#13;&#10;ELSEIF CONTAINS([Store], &quot;100 East 10th Street&quot;) then &quot;13481&quot;&#13;&#10;ELSEIF CONTAINS([Store], &quot;Winterville&quot;) then &quot;27296&quot;&#13;&#10;else [Store]&#13;&#10;END' />
            </column>
            <column caption='Rubicon Period' datatype='string' name='[Calculation_412923817395253256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Date]&gt; #2026-01-06# THEN &quot;Rubicon Hauling&quot;&#13;&#10;ELSE &quot;Pre-Rubicon&quot;&#13;&#10;END' />
            </column>
